# PostgreSQL connection for the app (runtime role).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/vortech

# Superuser URL used only by tests to create/drop ephemeral test databases.
TEST_DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/postgres

# Session cookie settings.
SESSION_COOKIE_NAME=vortech_session
SESSION_TTL_HOURS=720

# 32-byte hex key used to encrypt TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=replace-with-32-byte-hex

# Public origin of the app.
APP_ORIGIN=http://localhost:3000

# Public domain served by Caddy (automatic HTTPS). Used by docker-compose.
DOMAIN=example.com

# PostgreSQL credentials for the docker-compose `postgres` service. The web
# service builds its own DATABASE_URL from these when running under compose.
POSTGRES_USER=vortech
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vortech

# Backup settings (scripts/backup.ts, scripts/restore.ts).
# Directory backups are written to (git-ignored). Default: ./backups
BACKUP_DIR=./backups
# Passphrase used to encrypt backups (openssl AES-256 + PBKDF2). If unset,
# backups are written UNENCRYPTED and must be moved off-VPS immediately.
BACKUP_PASSPHRASE=replace-with-strong-passphrase
# Restore safety guard: must equal the target database name to allow a restore.
# RESTORE_CONFIRM=vortech
# Optional: force (1) or skip (0) decryption on restore, overriding the .enc suffix.
# RESTORE_DECRYPT=

# Dev-only seed account passwords (npm run db:seed). These are local
# development credentials, NOT real secrets; safe defaults are used when unset.
# Override anywhere beyond local dev. See README "Seed data".
SEED_SUPERADMIN_PASSWORD=Superadmin-Dev-0000
SEED_DEMO_ADMIN_PASSWORD=Admin-Dev-0000
SEED_DEMO_MANAGER_PASSWORD=Manager-Dev-0000
SEED_DEMO_MEMBER_PASSWORD=Member-Dev-0000

# Optional local display name for the prototype.
NEXT_PUBLIC_APP_NAME=Attendance Management Prototype

# This prototype is always mock-only. Do not put secrets in this file.
NEXT_PUBLIC_DEMO_MODE=true
